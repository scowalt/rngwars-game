<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Models.fs" />
    <Compile Include="SqliteSchema.fs" />
    <Compile Include="Database.fs" />
    <Compile Include="Auth.fs" />
    <Compile Include="ConnectionTracker.fs" />
    <Compile Include="Elo.fs" />
    <Compile Include="MatchAgent.fs" />
    <Compile Include="MatchManager.fs" />
    <Compile Include="MatchmakingQueue.fs" />
    <Compile Include="GameHub.fs" />
    <Compile Include="ApiHandlers.fs" />
    <Compile Include="OAuthHandlers.fs" />
    <Compile Include="Routes.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="migrations/*.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="dbup-sqlite" Version="6.0.4" />
    <PackageReference Include="Sentry.AspNetCore" Version="6.11.1" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Donald" Version="10.1.0" />
    <PackageReference Include="Giraffe" Version="8.3.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

</Project>
