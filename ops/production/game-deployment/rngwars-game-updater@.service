[Unit]
Description=One authorized RNGWars game update
After=network-online.target

[Service]
Type=exec
User=root
Group=root
ExecStart=/usr/bin/python3 -I -c "import sys; sys.path.insert(0, '{helper_directory}'); from game_updater import main; raise SystemExit(main())" serve --policy {policy_file}
Environment=PATH={tool_directory}:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TZ=UTC
Environment=LC_ALL=C
StandardInput=socket
StandardOutput=socket
StandardError=journal
UMask=0077
RuntimeMaxSec=930
TimeoutStopSec=10
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_SETUID
ReadWritePaths={state_directory} {work_directory} {data_directory} {backup_state_directory}
LimitCORE=0
MemoryMax=512M
TasksMax=96
